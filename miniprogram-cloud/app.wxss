page {
    min-height: 100%;
    background: #F5F3FB;
    color: #332C55;
    font-size: 28rpx;
    line-height: 1.6;
    font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page {
    padding: 24rpx 24rpx 48rpx;
    box-sizing: border-box;
}

.panel {
    background: #ffffff;
    border-radius: 20rpx;
    padding: 28rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 4rpx 16rpx rgba(76, 55, 168, 0.08);
}

.heading-title {
    display: block;
    font-size: 40rpx;
    font-weight: 700;
    color: #2B2350;
}

.heading-sub {
    display: block;
    font-size: 24rpx;
    color: #8B86A8;
    margin-top: 6rpx;
    margin-bottom: 24rpx;
}

.pill {
    display: inline-block;
    padding: 4rpx 16rpx;
    border-radius: 999rpx;
    font-size: 22rpx;
    background: #F0EDF8;
    color: #6E6A8F;
    margin: 0 10rpx 8rpx 0;
}

.pill-blue {
    background: #EEEAFF;
    color: #7C5CFC;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18rpx 36rpx;
    border-radius: 999rpx;
    font-size: 28rpx;
    background: #F0EDF8;
    color: #332C55;
    border: none;
    line-height: 1.4;
}

.btn::after {
    border: none;
}

.btn-primary {
    background: linear-gradient(135deg, #9B7BFF 0%, #7C5CFC 100%);
    color: #ffffff;
    font-weight: 600;
    box-shadow: 0 8rpx 20rpx rgba(124, 92, 252, 0.32);
}

.btn-block {
    display: flex;
    width: 100%;
    box-sizing: border-box;
}

.btn-disabled {
    opacity: 0.45;
}

.muted {
    color: #8B86A8;
    font-size: 24rpx;
}

.state-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 120rpx 48rpx;
    text-align: center;
}

.spinner {
    width: 48rpx;
    height: 48rpx;
    border: 4rpx solid #DED7FA;
    border-top-color: #7C5CFC;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-bottom: 24rpx;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

.state-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #2B2350;
    margin-bottom: 12rpx;
}

.state-text {
    font-size: 26rpx;
    color: #8B86A8;
    margin-bottom: 32rpx;
}

.item-row {
    display: flex;
    align-items: flex-start;
    background: #ffffff;
    border-radius: 20rpx;
    padding: 24rpx;
    margin-bottom: 16rpx;
    box-shadow: 0 4rpx 16rpx rgba(76, 55, 168, 0.08);
}

.item-number {
    font-size: 24rpx;
    color: #A9A4C4;
    font-weight: 600;
    margin-right: 20rpx;
    padding-top: 6rpx;
    min-width: 48rpx;
}

.item-body {
    flex: 1;
    min-width: 0;
}

.item-title {
    display: block;
    font-size: 28rpx;
    font-weight: 600;
    color: #2B2350;
}

.item-foot {
    display: block;
    font-size: 24rpx;
    color: #8B86A8;
    margin-top: 10rpx;
}

.notice {
    background: #fff8e6;
    border: 1rpx solid #f3e2ac;
    color: #7a5d00;
    border-radius: 12rpx;
    padding: 20rpx 24rpx;
    font-size: 24rpx;
    margin-bottom: 24rpx;
}

.footer-note {
    font-size: 22rpx;
    color: #A9A4C4;
    margin-top: 20rpx;
}
