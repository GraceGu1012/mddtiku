page {
    min-height: 100%;
    background: #f5f7fa;
    color: #1f2d3d;
    font-size: 28rpx;
    line-height: 1.6;
    font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page {
    padding: 24rpx 24rpx 48rpx;
    box-sizing: border-box;
}

.panel {
    background: #ffffff;
    border-radius: 16rpx;
    padding: 28rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 2rpx 8rpx rgba(16, 42, 84, 0.05);
}

.heading-title {
    display: block;
    font-size: 40rpx;
    font-weight: 700;
    color: #14213d;
}

.heading-sub {
    display: block;
    font-size: 24rpx;
    color: #7a869a;
    margin-top: 6rpx;
    margin-bottom: 24rpx;
}

.pill {
    display: inline-block;
    padding: 4rpx 16rpx;
    border-radius: 999rpx;
    font-size: 22rpx;
    background: #eef2f7;
    color: #5b6b7f;
    margin: 0 10rpx 8rpx 0;
}

.pill-blue {
    background: #e8f2fd;
    color: #1d6fd1;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18rpx 36rpx;
    border-radius: 999rpx;
    font-size: 28rpx;
    background: #eef2f7;
    color: #1f2d3d;
    border: none;
    line-height: 1.4;
}

.btn::after {
    border: none;
}

.btn-primary {
    background: #1d6fd1;
    color: #ffffff;
}

.btn-block {
    display: flex;
    width: 100%;
    box-sizing: border-box;
}

.btn-disabled {
    opacity: 0.45;
}

.muted {
    color: #7a869a;
    font-size: 24rpx;
}

.state-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 120rpx 48rpx;
    text-align: center;
}

.spinner {
    width: 48rpx;
    height: 48rpx;
    border: 4rpx solid #d7e3f5;
    border-top-color: #1d6fd1;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-bottom: 24rpx;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

.state-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #14213d;
    margin-bottom: 12rpx;
}

.state-text {
    font-size: 26rpx;
    color: #7a869a;
    margin-bottom: 32rpx;
}

.item-row {
    display: flex;
    align-items: flex-start;
    background: #ffffff;
    border-radius: 16rpx;
    padding: 24rpx;
    margin-bottom: 16rpx;
    box-shadow: 0 2rpx 8rpx rgba(16, 42, 84, 0.05);
}

.item-number {
    font-size: 24rpx;
    color: #9aa7ba;
    font-weight: 600;
    margin-right: 20rpx;
    padding-top: 6rpx;
    min-width: 48rpx;
}

.item-body {
    flex: 1;
    min-width: 0;
}

.item-title {
    display: block;
    font-size: 28rpx;
    font-weight: 600;
    color: #14213d;
}

.item-foot {
    display: block;
    font-size: 24rpx;
    color: #7a869a;
    margin-top: 10rpx;
}

.notice {
    background: #fff8e6;
    border: 1rpx solid #f3e2ac;
    color: #7a5d00;
    border-radius: 12rpx;
    padding: 20rpx 24rpx;
    font-size: 24rpx;
    margin-bottom: 24rpx;
}

.footer-note {
    font-size: 22rpx;
    color: #9aa7ba;
    margin-top: 20rpx;
}
