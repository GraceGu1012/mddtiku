.finish-panel {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.finish-eyebrow {
    font-size: 20rpx;
    letter-spacing: 4rpx;
    color: #7C5CFC;
    font-weight: 600;
    margin-bottom: 12rpx;
}

.finish-title {
    font-size: 36rpx;
    font-weight: 700;
    color: #2B2350;
    margin-bottom: 20rpx;
}

.finish-score {
    font-size: 88rpx;
    font-weight: 700;
    color: #7C5CFC;
    line-height: 1.2;
}

.finish-line {
    display: block;
    font-size: 26rpx;
    color: #332C55;
    margin: 20rpx 0 8rpx;
}

.actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16rpx;
    margin-top: 28rpx;
}

.section-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #2B2350;
    display: block;
    margin-bottom: 16rpx;
}

.answer-map {
    display: flex;
    flex-wrap: wrap;
}

.map-cell {
    width: 56rpx;
    height: 56rpx;
    border-radius: 12rpx;
    background: #F0EDF8;
    color: #6E6A8F;
    font-size: 24rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 12rpx 12rpx 0;
}

.map-right {
    background: #e3f6e9;
    color: #1c8a45;
}

.map-wrong {
    background: #fde8e8;
    color: #c8332e;
}

.map-unavailable {
    background: #EFEAF8;
    color: #A9A4C4;
    text-decoration: line-through;
}
