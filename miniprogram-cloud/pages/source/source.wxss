.source-title {
    display: block;
    font-size: 30rpx;
    font-weight: 600;
    color: #14213d;
    margin-bottom: 20rpx;
}

.context {
    border: 2rpx solid #f0f3f8;
    border-radius: 12rpx;
    padding: 20rpx;
    margin-bottom: 16rpx;
}

.context-selected {
    border-color: #1d6fd1;
    background: #f5faff;
}

.context-label {
    font-size: 22rpx;
    color: #9aa7ba;
}

.context-text {
    display: block;
    font-size: 26rpx;
    color: #1f2d3d;
    margin-top: 10rpx;
}
