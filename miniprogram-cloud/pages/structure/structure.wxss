.material-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16rpx;
}

.material-info {
    flex: 1;
    min-width: 0;
}

.material-name {
    display: block;
    font-size: 30rpx;
    font-weight: 600;
    color: #2B2350;
}

.material-meta {
    display: block;
    font-size: 22rpx;
    color: #8B86A8;
    margin-top: 4rpx;
}

.material-side {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    margin-left: 16rpx;
}

.material-percent {
    font-size: 30rpx;
    font-weight: 700;
    color: #7C5CFC;
}

.material-arrow {
    font-size: 24rpx;
    color: #A9A4C4;
    margin-left: 12rpx;
}

.meter {
    height: 12rpx;
    background: #F0EDF8;
    border-radius: 999rpx;
    overflow: hidden;
}

.meter-fill {
    height: 100%;
    border-radius: 999rpx;
    background: linear-gradient(90deg, #9B7BFF 0%, #7C5CFC 100%);
}

.units {
    margin-top: 20rpx;
}

.unit {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18rpx 0;
    border-top: 1rpx solid #EFEAF8;
}

.unit-info {
    flex: 1;
    min-width: 0;
}

.unit-label {
    display: block;
    font-size: 26rpx;
    color: #332C55;
    font-weight: 500;
}

.unit-meta {
    display: block;
    font-size: 22rpx;
    color: #A9A4C4;
    margin-top: 2rpx;
}

.unit-state {
    font-size: 22rpx;
    padding: 6rpx 18rpx;
    border-radius: 999rpx;
    flex-shrink: 0;
    margin-left: 16rpx;
}

.state-done {
    background: #EEEAFF;
    color: #7C5CFC;
}

.state-doing {
    background: #FFF3E3;
    color: #FF9F43;
}

.state-new {
    background: #F0EDF8;
    color: #A9A4C4;
}

.quick-actions {
    display: flex;
    gap: 20rpx;
}

.quick-actions .btn {
    flex: 1;
}

.mascot-big {
    font-size: 88rpx;
    line-height: 1.2;
    margin-bottom: 16rpx;
}
