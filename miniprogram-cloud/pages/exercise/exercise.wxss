.head-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 24rpx;
}

.progress-panel {
    margin-bottom: 24rpx;
}

.progress-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16rpx;
}

.section-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #14213d;
}

.meter {
    height: 12rpx;
    background: #eef2f7;
    border-radius: 999rpx;
    overflow: hidden;
    margin-bottom: 20rpx;
}

.meter-fill {
    height: 100%;
    background: #1d6fd1;
    border-radius: 999rpx;
}

.answer-map {
    display: flex;
    flex-wrap: wrap;
}

.map-cell {
    width: 56rpx;
    height: 56rpx;
    border-radius: 12rpx;
    background: #eef2f7;
    color: #5b6b7f;
    font-size: 24rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 12rpx 12rpx 0;
}

.map-right {
    background: #e3f6e9;
    color: #1c8a45;
}

.map-wrong {
    background: #fde8e8;
    color: #c8332e;
}

.map-unavailable {
    background: #f0f3f8;
    color: #9aa7ba;
    text-decoration: line-through;
}

.map-current {
    border: 3rpx solid #1d6fd1;
    box-sizing: border-box;
}

.q-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
}

.q-pills {
    flex: 1;
    min-width: 0;
}

.question-title {
    display: block;
    font-size: 32rpx;
    font-weight: 700;
    color: #14213d;
    margin: 12rpx 0 8rpx;
    line-height: 1.5;
}

.options {
    margin-top: 24rpx;
}

.option {
    display: flex;
    align-items: flex-start;
    background: #f7f9fc;
    border: 2rpx solid #e3e9f2;
    border-radius: 14rpx;
    padding: 22rpx 24rpx;
    margin-bottom: 16rpx;
}

.option-letter {
    width: 44rpx;
    height: 44rpx;
    border-radius: 50%;
    background: #eef2f7;
    color: #5b6b7f;
    font-size: 24rpx;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 20rpx;
    flex-shrink: 0;
}

.option-text {
    flex: 1;
    font-size: 28rpx;
    color: #1f2d3d;
}

.option-selected {
    border-color: #1d6fd1;
    background: #eaf3fd;
}

.option-selected .option-letter {
    background: #1d6fd1;
    color: #ffffff;
}

.option-correct {
    border-color: #1c8a45;
    background: #e3f6e9;
}

.option-correct .option-letter {
    background: #1c8a45;
    color: #ffffff;
}

.option-wrong {
    border-color: #c8332e;
    background: #fde8e8;
}

.option-wrong .option-letter {
    background: #c8332e;
    color: #ffffff;
}

.answer-result {
    background: #e3f6e9;
    border-radius: 12rpx;
    padding: 20rpx 24rpx;
    margin-top: 8rpx;
}

.answer-result-wrong {
    background: #fde8e8;
}

.answer-result-title {
    display: block;
    font-size: 28rpx;
    font-weight: 700;
    color: #14213d;
}

.answer-result-text {
    display: block;
    font-size: 26rpx;
    color: #1f2d3d;
    margin-top: 6rpx;
}

.actions {
    display: flex;
    justify-content: flex-end;
    gap: 16rpx;
    margin-top: 24rpx;
}

.explanation {
    margin-top: 32rpx;
    border-top: 1rpx solid #f0f3f8;
    padding-top: 24rpx;
}

.exp-title {
    display: block;
    font-size: 28rpx;
    font-weight: 700;
    color: #14213d;
    margin: 20rpx 0 12rpx;
}

.exp-quote {
    background: #f7f9fc;
    border-left: 6rpx solid #bad3ef;
    border-radius: 8rpx;
    padding: 18rpx 20rpx;
    margin-bottom: 16rpx;
}

.exp-link {
    display: block;
    font-size: 24rpx;
    color: #1d6fd1;
    margin-bottom: 8rpx;
}

.exp-quote-text {
    display: block;
    font-size: 26rpx;
    color: #3d4a5c;
}

.exp-text {
    display: block;
    font-size: 26rpx;
    color: #3d4a5c;
    margin-bottom: 8rpx;
}

.exp-option {
    margin-top: 8rpx;
}
