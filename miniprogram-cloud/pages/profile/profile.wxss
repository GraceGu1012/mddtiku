.account-heading {
    display: flex;
    align-items: center;
    margin-bottom: 24rpx;
}

.profile-avatar {
    width: 88rpx;
    height: 88rpx;
    border-radius: 50%;
    background: #EEEAFF;
    color: #7C5CFC;
    font-size: 36rpx;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 24rpx;
    flex-shrink: 0;
}

.account-name {
    font-size: 32rpx;
    font-weight: 600;
    color: #2B2350;
}

.account-info {
    display: flex;
    flex-wrap: wrap;
    padding: 16rpx 0;
    border-top: 1rpx solid #EFEAF8;
    border-bottom: 1rpx solid #EFEAF8;
}

.account-info-label {
    width: 30%;
    font-size: 24rpx;
    color: #A9A4C4;
    padding: 6rpx 0;
}

.account-info-value {
    width: 70%;
    font-size: 24rpx;
    color: #332C55;
    font-weight: 600;
    padding: 6rpx 0;
}

.profile-stats {
    display: flex;
    background: #ffffff;
    border-radius: 16rpx;
    padding: 28rpx 0;
    margin-bottom: 24rpx;
    box-shadow: 0 2rpx 8rpx rgba(76, 55, 168, 0.08);
}

.profile-stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.profile-stat-value {
    font-size: 40rpx;
    font-weight: 700;
    color: #2B2350;
}

.profile-stat-label {
    font-size: 22rpx;
    color: #8B86A8;
    margin-top: 4rpx;
}

.section-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #2B2350;
    display: block;
    margin-bottom: 8rpx;
}

.profile-link {
    display: flex;
    align-items: center;
    padding: 24rpx 0;
    border-top: 1rpx solid #EFEAF8;
}

.profile-link-body {
    flex: 1;
    min-width: 0;
}

.profile-link-title {
    display: block;
    font-size: 28rpx;
    font-weight: 600;
    color: #2B2350;
}

.profile-link-desc {
    display: block;
    font-size: 22rpx;
    color: #A9A4C4;
    margin-top: 2rpx;
}

.profile-link-count {
    font-size: 22rpx;
    color: #8B86A8;
    margin-right: 12rpx;
    flex-shrink: 0;
}

.profile-link-arrow {
    font-size: 32rpx;
    color: #c4cdd9;
    flex-shrink: 0;
}

/* 游戏化档案卡 */
.game-panel {
    padding: 28rpx;
}

.game-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18rpx;
}

.game-left {
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 0;
}

.game-avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    background: linear-gradient(135deg, #9B7BFF 0%, #7C5CFC 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40rpx;
    margin-right: 20rpx;
    flex-shrink: 0;
}

.game-info {
    min-width: 0;
}

.game-name {
    display: block;
    font-size: 30rpx;
    font-weight: 600;
    color: #2B2350;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.game-title {
    display: block;
    font-size: 24rpx;
    color: #7C5CFC;
    margin-top: 4rpx;
}

.game-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
}

.game-streak {
    font-size: 28rpx;
    font-weight: 700;
    color: #FF9F43;
}

.game-rank {
    font-size: 22rpx;
    color: #7C5CFC;
    margin-top: 4rpx;
}

.game-bar {
    height: 14rpx;
    background: #EEEAFF;
    border-radius: 999rpx;
    overflow: hidden;
}

.game-bar-fill {
    height: 100%;
    border-radius: 999rpx;
    background: linear-gradient(90deg, #9B7BFF 0%, #7C5CFC 100%);
}

.game-foot {
    display: flex;
    justify-content: space-between;
    font-size: 22rpx;
    color: #8B86A8;
    margin-top: 10rpx;
}

/* 头像（微信 chooseAvatar）与用户名编辑 */
.avatar-btn {
    position: relative;
    width: 80rpx;
    height: 80rpx;
    padding: 0;
    margin: 0 20rpx 0 0;
    border-radius: 50%;
    background: transparent;
    line-height: 1;
    flex-shrink: 0;
    overflow: visible;
}

.avatar-btn::after {
    border: none;
}

.game-avatar-img {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
}

.avatar-edit-hint {
    position: absolute;
    right: -6rpx;
    bottom: -6rpx;
    width: 32rpx;
    height: 32rpx;
    border-radius: 50%;
    background: #7C5CFC;
    color: #ffffff;
    font-size: 18rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2rpx solid #ffffff;
}

.name-row {
    display: flex;
    align-items: center;
    gap: 12rpx;
    min-width: 0;
}

.name-edit {
    font-size: 22rpx;
    color: #7C5CFC;
    flex-shrink: 0;
}

.name-save {
    font-weight: 600;
}

.name-cancel {
    color: #A9A4C4;
}

.name-input {
    border-bottom: 2rpx solid #DED7FA;
    font-size: 28rpx;
    font-weight: 600;
    color: #2B2350;
    min-width: 200rpx;
    max-width: 300rpx;
    padding: 4rpx 0;
}

.name-hint {
    display: block;
    font-size: 20rpx;
    color: #A9A4C4;
    margin-top: 6rpx;
}

.phone-btn {
    margin-top: 20rpx;
    width: 100%;
    font-size: 26rpx;
}
