.account-heading {
    display: flex;
    align-items: center;
    margin-bottom: 24rpx;
}

.profile-avatar {
    width: 88rpx;
    height: 88rpx;
    border-radius: 50%;
    background: #e8f2fd;
    color: #1d6fd1;
    font-size: 36rpx;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 24rpx;
    flex-shrink: 0;
}

.account-name {
    font-size: 32rpx;
    font-weight: 600;
    color: #14213d;
}

.account-info {
    display: flex;
    flex-wrap: wrap;
    padding: 16rpx 0;
    border-top: 1rpx solid #f0f3f8;
    border-bottom: 1rpx solid #f0f3f8;
}

.account-info-label {
    width: 30%;
    font-size: 24rpx;
    color: #9aa7ba;
    padding: 6rpx 0;
}

.account-info-value {
    width: 70%;
    font-size: 24rpx;
    color: #1f2d3d;
    font-weight: 600;
    padding: 6rpx 0;
}

.profile-stats {
    display: flex;
    background: #ffffff;
    border-radius: 16rpx;
    padding: 28rpx 0;
    margin-bottom: 24rpx;
    box-shadow: 0 2rpx 8rpx rgba(16, 42, 84, 0.05);
}

.profile-stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.profile-stat-value {
    font-size: 40rpx;
    font-weight: 700;
    color: #14213d;
}

.profile-stat-label {
    font-size: 22rpx;
    color: #7a869a;
    margin-top: 4rpx;
}

.section-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #14213d;
    display: block;
    margin-bottom: 8rpx;
}

.profile-link {
    display: flex;
    align-items: center;
    padding: 24rpx 0;
    border-top: 1rpx solid #f0f3f8;
}

.profile-link-body {
    flex: 1;
    min-width: 0;
}

.profile-link-title {
    display: block;
    font-size: 28rpx;
    font-weight: 600;
    color: #14213d;
}

.profile-link-desc {
    display: block;
    font-size: 22rpx;
    color: #9aa7ba;
    margin-top: 2rpx;
}

.profile-link-count {
    font-size: 22rpx;
    color: #7a869a;
    margin-right: 12rpx;
    flex-shrink: 0;
}

.profile-link-arrow {
    font-size: 32rpx;
    color: #c4cdd9;
    flex-shrink: 0;
}
