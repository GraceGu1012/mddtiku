<view class="page">
    <view wx:if="{{state === 'loading'}}" class="state-box">
        <view class="spinner"></view>
        <text class="state-text">正在读取学习档案…</text>
    </view>

    <view wx:elif="{{state === 'error'}}" class="state-box">
        <text class="state-title">暂时无法打开</text>
        <text class="state-text">{{errorMsg}}</text>
        <button class="btn btn-primary" bindtap="handleRetry">重试</button>
    </view>

    <block wx:else>
        <text class="heading-title">我的</text>
        <text class="heading-sub">学习档案与复习内容，都在这里。</text>

        <view class="panel game-panel">
            <view class="game-top">
                <view class="game-left">
                    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
                        <image wx:if="{{avatar}}" class="game-avatar-img" src="{{avatar}}" mode="aspectFill" />
                        <view wx:else class="game-avatar">🦉</view>
                        <view class="avatar-edit-hint">改</view>
                    </button>
                    <view class="game-info">
                        <view class="name-row" wx:if="{{!editingName}}">
                            <text class="game-name">{{nickname || profileLabel}}</text>
                            <text class="name-edit" bindtap="startEditName">{{hasPhone ? '修改' : ''}}</text>
                        </view>
                        <view class="name-row" wx:else>
                            <input class="name-input" type="nickname" value="{{nameInput}}" maxlength="20"
                                focus placeholder="输入用户名" bindinput="onNameInput" bindconfirm="saveName" />
                            <text class="name-edit name-save" bindtap="saveName">保存</text>
                            <text class="name-edit name-cancel" bindtap="cancelEditName">取消</text>
                        </view>
                        <text class="game-title">{{levelName}} · Lv{{level}}</text>
                        <text wx:if="{{!hasPhone}}" class="name-hint">绑定手机号后可修改用户名</text>
                    </view>
                </view>
                <view class="game-right" bindtap="goLeaderboard">
                    <text class="game-streak">🔥 {{streakDays}} 天</text>
                    <text class="game-rank">排行榜 ›</text>
                </view>
            </view>
            <view class="game-bar">
                <view class="game-bar-fill" style="width: {{levelProgress}}%"></view>
            </view>
            <view class="game-foot">
                <text>{{xp}} XP</text>
                <text>今日 +{{todayXp}}</text>
            </view>
        </view>

        <view class="panel account-panel">
            <view class="account-heading">
                <view class="profile-avatar">学</view>
                <view>
                    <text class="account-name">{{profileLabel}}</text>
                    <view><text class="pill pill-blue">{{hasPhone ? '已绑定手机' : '当前设备档案'}}</text></view>
                </view>
            </view>
            <view class="account-info">
                <text class="account-info-label">手机号</text>
                <text class="account-info-value">{{hasPhone ? phoneMasked : '未绑定'}}</text>
                <text class="account-info-label">账号信息</text>
                <text class="account-info-value">{{hasPhone ? '手机档案' : '设备学习档案'}}</text>
                <text class="account-info-label">保存状态</text>
                <text class="account-info-value">学习记录自动保存</text>
            </view>
            <button wx:if="{{!hasPhone}}" class="btn btn-primary phone-btn" open-type="getPhoneNumber"
                bindgetphonenumber="onGetPhone">绑定手机号（微信授权）</button>
        </view>

        <view class="profile-stats">
            <view class="profile-stat">
                <text class="profile-stat-value">{{attempts}}</text>
                <text class="profile-stat-label">累计作答</text>
            </view>
            <view class="profile-stat">
                <text class="profile-stat-value">{{correctRate}}</text>
                <text class="profile-stat-label">作答正确率</text>
            </view>
            <view class="profile-stat">
                <text class="profile-stat-value">{{rememberedCount}}</text>
                <text class="profile-stat-label">已记住卡片 · 自评</text>
            </view>
        </view>

        <view class="panel">
            <text class="section-title">我的学习</text>
            <view class="profile-link" wx:for="{{menuItems}}" wx:key="key" data-key="{{item.key}}" bindtap="handleMenuTap">
                <view class="profile-link-body">
                    <text class="profile-link-title">{{item.title}}</text>
                    <text class="profile-link-desc">{{item.desc}}</text>
                </view>
                <text class="profile-link-count">{{item.count}}</text>
                <text class="profile-link-arrow">›</text>
            </view>
        </view>

        <view class="panel" wx:if="{{identityNote}}">
            <text class="muted">{{identityNote}}</text>
        </view>
    </block>
</view>
