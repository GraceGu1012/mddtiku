.stats {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -8rpx 16rpx;
}

.stat {
    width: calc(33.33% - 16rpx);
    box-sizing: border-box;
    background: #ffffff;
    border-radius: 16rpx;
    padding: 24rpx 16rpx;
    margin: 0 8rpx 16rpx;
    box-shadow: 0 2rpx 8rpx rgba(76, 55, 168, 0.08);
    display: flex;
    flex-direction: column;
    align-items: center;
}

.stat-label {
    font-size: 20rpx;
    color: #8B86A8;
}

.stat-value {
    font-size: 40rpx;
    font-weight: 700;
    color: #2B2350;
    margin: 4rpx 0;
}

.stat-hint {
    font-size: 18rpx;
    color: #A9A4C4;
}

.list-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8rpx;
}

.section-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #2B2350;
}

.history-row {
    display: flex;
    align-items: center;
    padding: 24rpx 0;
    border-top: 1rpx solid #EFEAF8;
}

.history-row:first-of-type {
    border-top: none;
}

.history-body {
    flex: 1;
    min-width: 0;
}

.history-title {
    display: block;
    font-size: 28rpx;
    font-weight: 600;
    color: #2B2350;
}

.history-detail {
    display: block;
    font-size: 22rpx;
    color: #8B86A8;
    margin-top: 4rpx;
}

.history-btn {
    flex-shrink: 0;
    margin-left: 16rpx;
    font-size: 24rpx;
    padding: 12rpx 28rpx;
}

.empty-inline {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 48rpx 0 24rpx;
    gap: 20rpx;
}
