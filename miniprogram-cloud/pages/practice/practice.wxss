.picker-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20rpx 0;
    border-bottom: 1rpx solid #EFEAF8;
}

.picker-label {
    font-size: 26rpx;
    color: #6E6A8F;
}

.picker-value {
    font-size: 26rpx;
    color: #7C5CFC;
    max-width: 65%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.match-note {
    display: block;
    font-size: 22rpx;
    color: #A9A4C4;
    margin: 20rpx 0;
}

.list-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 8rpx 0 16rpx;
}

.section-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #2B2350;
}
