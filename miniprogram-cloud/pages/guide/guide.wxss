.guide-page {
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: linear-gradient(160deg, #F1ECFF 0%, #FBFAFF 55%, #ffffff 100%);
    box-sizing: border-box;
    padding: 120rpx 48rpx 80rpx;
}

.guide-swiper {
    width: 100%;
    flex: 1;
}

.slide {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.mascot-circle {
    width: 240rpx;
    height: 240rpx;
    border-radius: 50%;
    background: linear-gradient(135deg, #9B7BFF 0%, #7C5CFC 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 16rpx 40rpx rgba(124, 92, 252, 0.35);
    margin-bottom: 56rpx;
}

.mascot-emoji {
    font-size: 120rpx;
    line-height: 1;
}

.slide-title {
    font-size: 44rpx;
    font-weight: 700;
    color: #2B2350;
    margin-bottom: 20rpx;
}

.slide-desc {
    font-size: 28rpx;
    color: #6E6A8F;
    line-height: 1.7;
    max-width: 520rpx;
}

.guide-dots {
    display: flex;
    gap: 12rpx;
    margin-bottom: 40rpx;
}

.dot {
    width: 14rpx;
    height: 14rpx;
    border-radius: 999rpx;
    background: #DED7FA;
    transition: all 0.25s ease;
}

.dot-active {
    width: 40rpx;
    background: #7C5CFC;
}

.guide-btn {
    width: 100%;
}
