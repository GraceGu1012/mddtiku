.assistant-page {
    display: flex;
    flex-direction: column;
    height: 100vh;
    box-sizing: border-box;
    padding-bottom: 0;
}

.chat-list {
    flex: 1;
    min-height: 0;
    padding-bottom: 20rpx;
}

.msg {
    display: flex;
    align-items: flex-start;
    margin-bottom: 20rpx;
}

.msg-me {
    justify-content: flex-end;
}

.bot-avatar {
    width: 64rpx;
    height: 64rpx;
    border-radius: 50%;
    background: linear-gradient(135deg, #9B7BFF 0%, #7C5CFC 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 34rpx;
    margin-right: 16rpx;
    flex-shrink: 0;
}

.bubble {
    max-width: 76%;
    padding: 20rpx 24rpx;
    border-radius: 20rpx;
    font-size: 27rpx;
    line-height: 1.6;
    word-break: break-all;
}

.bubble-bot {
    background: #ffffff;
    color: #332C55;
    box-shadow: 0 4rpx 16rpx rgba(76, 55, 168, 0.08);
    border-top-left-radius: 6rpx;
}

.bubble-me {
    background: linear-gradient(135deg, #9B7BFF 0%, #7C5CFC 100%);
    color: #ffffff;
    border-top-right-radius: 6rpx;
    box-shadow: 0 6rpx 16rpx rgba(124, 92, 252, 0.28);
}

.typing {
    display: flex;
    gap: 10rpx;
    align-items: center;
    padding: 26rpx 28rpx;
}

.dot-typing {
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
    background: #C9BFF5;
    animation: blink 1.2s infinite ease-in-out;
}

.dot-typing:nth-child(2) {
    animation-delay: 0.2s;
}

.dot-typing:nth-child(3) {
    animation-delay: 0.4s;
}

@keyframes blink {
    0%,
    80%,
    100% {
        opacity: 0.3;
    }
    40% {
        opacity: 1;
    }
}

.chat-input {
    display: flex;
    align-items: center;
    gap: 16rpx;
    padding: 16rpx 0 32rpx;
    background: #F5F3FB;
}

.input {
    flex: 1;
    background: #ffffff;
    border-radius: 999rpx;
    padding: 18rpx 28rpx;
    font-size: 27rpx;
    box-shadow: 0 4rpx 16rpx rgba(76, 55, 168, 0.08);
}

.send-btn {
    flex-shrink: 0;
    font-size: 26rpx;
    padding: 14rpx 32rpx;
}
