<view class="page assistant-page">
    <view wx:if="{{state === 'loading'}}" class="state-box">
        <view class="spinner"></view>
        <text class="state-text">正在连接学习助手…</text>
    </view>

    <view wx:elif="{{state === 'error'}}" class="state-box">
        <text class="state-title">暂时无法打开</text>
        <text class="state-text">{{errorMsg}}</text>
    </view>

    <block wx:else>
        <scroll-view class="chat-list" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation>
            <view id="bottom"></view>
            <view class="msg {{item.role === 'me' ? 'msg-me' : 'msg-bot'}}" wx:for="{{messages}}" wx:key="id">
                <view wx:if="{{item.role === 'bot'}}" class="bot-avatar">🦉</view>
                <view class="bubble {{item.role === 'me' ? 'bubble-me' : 'bubble-bot'}}">
                    <text>{{item.text}}</text>
                </view>
            </view>
            <view class="msg msg-bot" wx:if="{{sending}}">
                <view class="bot-avatar">🦉</view>
                <view class="bubble bubble-bot typing">
                    <view class="dot-typing"></view>
                    <view class="dot-typing"></view>
                    <view class="dot-typing"></view>
                </view>
            </view>
        </scroll-view>

        <view class="chat-input">
            <input
                class="input"
                placeholder="输入你的问题，如：什么是XX？"
                value="{{input}}"
                confirm-type="send"
                bindinput="onInput"
                bindconfirm="send"
                disabled="{{sending}}"
            />
            <button class="btn btn-primary send-btn {{sending || !input ? 'btn-disabled' : ''}}" bindtap="send">发送</button>
        </view>
    </block>
</view>
