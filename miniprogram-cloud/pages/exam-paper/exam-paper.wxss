.heading-title, .heading-sub, .paragraph, .prompt, .muted { overflow-wrap: break-word; word-break: break-word; }
.counts { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; font-size: 24rpx; }
.paragraph { display: block; white-space: pre-wrap; margin: 20rpx 0; }
.prompt { display: block; font-size: 32rpx; font-weight: 600; white-space: pre-wrap; margin: 24rpx 0; }
.shared { background: #f5f3fb; padding: 20rpx; margin-top: 20rpx; border-radius: 12rpx; }
.option { display: flex; gap: 16rpx; margin: 12rpx 0; padding: 16rpx; background: #f5f3fb; border-radius: 12rpx; white-space: pre-wrap; overflow-wrap: break-word; }
.option text:last-child { min-width: 0; flex: 1; }
.question-nav { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; margin-bottom: 24rpx; }
.question-nav .btn { margin: 0; padding: 16rpx; font-size: 24rpx; flex-shrink: 0; }
.question-picker { font-size: 22rpx; padding: 16rpx 0; text-align: center; color: #6343db; }
.notes { margin-top: 24rpx; }
.evidence { border-top: 1rpx solid #e7e2f3; padding-top: 20rpx; margin-top: 20rpx; }
