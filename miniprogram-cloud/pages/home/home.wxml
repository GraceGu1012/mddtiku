<view class="page">
    <view wx:if="{{state === 'loading'}}" class="state-box">
        <view class="spinner"></view>
        <text class="state-text">正在读取已审核的学习内容…</text>
    </view>

    <view wx:elif="{{state === 'error'}}" class="state-box">
        <text class="state-title">暂时无法打开</text>
        <text class="state-text">{{errorMsg}}</text>
        <button class="btn btn-primary" bindtap="handleRetry">重试</button>
    </view>

    <block wx:else>
        <view class="gamify panel" bindtap="goLeaderboard">
            <view class="gamify-left">
                <view class="level-badge">Lv{{level}}</view>
                <view class="gamify-info">
                    <text class="gamify-name">{{levelName}}</text>
                    <view class="xp-bar">
                        <view class="xp-bar-fill" style="width: {{levelProgress}}%"></view>
                    </view>
                    <text class="gamify-xp">{{xp}} XP · 距下一级还差 {{((level + 1) * level * 50) - xp}}</text>
                </view>
            </view>
            <view class="gamify-right">
                <text class="streak">🔥 {{streakDays}} 天</text>
                <text class="today-xp">今日 +{{todayXp}}</text>
                <text class="rank-link">排行榜 ›</text>
            </view>
        </view>

        <view class="hero panel">
            <text class="hero-eyebrow">LEARN · PRACTICE · REMEMBER</text>
            <text class="hero-title">把学过的知识，变成答得出的答案。</text>
            <text class="hero-desc">从一组练习开始，回到原文，把不确定的地方弄明白。</text>
            <button class="btn btn-primary hero-btn" bindtap="goPrimary">{{resume ? '继续上次练习' : '开始今天的练习'}}</button>
        </view>

        <view class="mastery-row">
            <view class="mastery panel">
                <view class="ring-wrap">
                    <canvas type="2d" id="masteryRing" class="ring-canvas"></canvas>
                    <view class="ring-hole">
                        <text class="ring-num">{{masteryPercent}}%</text>
                        <text class="ring-label">掌握度</text>
                    </view>
                </view>
                <view class="mastery-legend">
                    <view class="legend-item"><view class="dot dot-done"></view><text>已记住 {{mastered}}</text></view>
                    <view class="legend-item"><view class="dot dot-learning"></view><text>待巩固 {{learning}}</text></view>
                    <view class="legend-item"><view class="dot dot-fresh"></view><text>未学 {{cardCount - mastered - learning}}</text></view>
                </view>
            </view>

            <view class="review panel" bindtap="goReview">
                <text class="mascot">🦉</text>
                <text class="review-title">今日复习</text>
                <text class="review-num">{{reviewCount}} 张</text>
                <text class="review-desc">待巩固卡片</text>
                <view class="btn btn-primary review-btn">{{reviewCount > 0 ? '开始复习' : '去翻卡'}}</view>
            </view>
        </view>

        <view class="stats">
            <view class="stat">
                <text class="stat-label">今日作答</text>
                <text class="stat-value">{{today}}</text>
                <text class="stat-hint">按提交次数统计</text>
            </view>
            <view class="stat">
                <text class="stat-label">累计练习</text>
                <text class="stat-value">{{attempts}}</text>
                <text class="stat-hint">包含重复练习</text>
            </view>
            <view class="stat">
                <text class="stat-label">作答正确率</text>
                <text class="stat-value">{{correctRate}}</text>
                <text class="stat-hint">按累计作答统计</text>
            </view>
            <view class="stat">
                <text class="stat-label">待巩固错题</text>
                <text class="stat-value">{{wrongCount}}</text>
                <text class="stat-hint">最新一次作答仍有误</text>
            </view>
        </view>

        <view class="panel">
            <view class="section-head">
                <text class="section-title">今天，从这里开始</text>
                <text class="muted">审核通过后可见</text>
            </view>
            <view class="entry" bindtap="goExamPapers">
                <view class="entry-body">
                    <text class="entry-title">十年真题</text>
                    <text class="entry-desc">年度套卷 · 查看原题与讲解整理进度</text>
                </view>
                <text class="entry-trailing">查看 ›</text>
            </view>
            <view class="entry" bindtap="goPractice">
                <view class="entry-body">
                    <text class="entry-title">课程练习</text>
                    <text class="entry-desc">{{questionCount}} 道可用题目 · 单选 / 多选 / 判断</text>
                </view>
                <text class="entry-trailing">去练习 ›</text>
            </view>
            <view class="entry" bindtap="goStructure">
                <view class="entry-body">
                    <text class="entry-title">课程结构</text>
                    <text class="entry-desc">章节 → 单元，卡片数 · 测验数 · 掌握状态</text>
                </view>
                <text class="entry-trailing">查看 ›</text>
            </view>
            <view class="entry" bindtap="goWrong">
                <view class="entry-body">
                    <text class="entry-title">回顾错题</text>
                    <text class="entry-desc">定位最近答错的知识点，再练一次</text>
                </view>
                <text class="entry-trailing">去巩固 ›</text>
            </view>
            <view class="entry" bindtap="goAssistant">
                <view class="entry-body">
                    <text class="entry-title">问一问墨督督</text>
                    <text class="entry-desc">AI 学习助手，基于课程资料答疑</text>
                </view>
                <text class="entry-trailing">去提问 ›</text>
            </view>
        </view>

        <view class="panel">
            <text class="section-title">让每一次练习有依据</text>
            <view class="step">
                <text class="step-num">1</text>
                <view class="step-body">
                    <text class="step-title">先独立作答</text>
                    <text class="step-desc">提交后查看答案与解析</text>
                </view>
            </view>
            <view class="step">
                <text class="step-num">2</text>
                <view class="step-body">
                    <text class="step-title">带着疑问回到材料</text>
                    <text class="step-desc">每条内容都有可点击的原文出处</text>
                </view>
            </view>
            <view class="step">
                <text class="step-num">3</text>
                <view class="step-body">
                    <text class="step-title">把薄弱点再练一次</text>
                    <text class="step-desc">答对后自动移出待巩固错题</text>
                </view>
            </view>
            <text class="footer-note">2017—2026 真题覆盖仍待核验；当前内容不标记未经证实的"常考"。</text>
        </view>
    </block>
</view>
