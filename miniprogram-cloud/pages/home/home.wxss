.hero {
    background: linear-gradient(160deg, #F1ECFF 0%, #FBFAFF 55%, #ffffff 100%);
    border-radius: 24rpx;
    padding: 36rpx 32rpx;
    margin-bottom: 24rpx;
}

.hero-eyebrow {
    display: block;
    font-size: 20rpx;
    letter-spacing: 4rpx;
    color: #7C5CFC;
    font-weight: 700;
    margin-bottom: 16rpx;
}

.hero-title {
    display: block;
    font-size: 42rpx;
    font-weight: 700;
    color: #2B2350;
    line-height: 1.35;
    margin-bottom: 16rpx;
}

.hero-desc {
    display: block;
    font-size: 26rpx;
    color: #6E6A8F;
    margin-bottom: 28rpx;
}

.hero-btn {
    align-self: flex-start;
}

.stats {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -8rpx 16rpx;
}

.stat {
    width: calc(50% - 16rpx);
    box-sizing: border-box;
    background: #ffffff;
    border-radius: 20rpx;
    padding: 24rpx;
    margin: 0 8rpx 16rpx;
    box-shadow: 0 4rpx 16rpx rgba(76, 55, 168, 0.08);
    display: flex;
    flex-direction: column;
}

.stat-label {
    font-size: 22rpx;
    color: #8B86A8;
}

.stat-value {
    font-size: 48rpx;
    font-weight: 700;
    color: #2B2350;
    margin: 6rpx 0;
}

.stat-hint {
    font-size: 20rpx;
    color: #A9A4C4;
}

.section-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16rpx;
}

.section-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #2B2350;
    display: block;
    margin-bottom: 16rpx;
}

.section-head .section-title {
    margin-bottom: 0;
}

.entry {
    display: flex;
    align-items: center;
    padding: 24rpx 0;
    border-top: 1rpx solid #EFEAF8;
}

.entry:first-of-type {
    border-top: none;
}

.entry-body {
    flex: 1;
    min-width: 0;
}

.entry-title {
    display: block;
    font-size: 28rpx;
    font-weight: 600;
    color: #2B2350;
}

.entry-desc {
    display: block;
    font-size: 24rpx;
    color: #8B86A8;
    margin-top: 4rpx;
}

.entry-trailing {
    font-size: 26rpx;
    color: #7C5CFC;
    margin-left: 16rpx;
    flex-shrink: 0;
}

.step {
    display: flex;
    align-items: flex-start;
    margin-top: 20rpx;
}

.step-num {
    width: 44rpx;
    height: 44rpx;
    border-radius: 50%;
    background: #EEEAFF;
    color: #7C5CFC;
    font-size: 24rpx;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 20rpx;
    flex-shrink: 0;
}

.step-title {
    display: block;
    font-size: 28rpx;
    font-weight: 600;
    color: #2B2350;
}

.step-desc {
    display: block;
    font-size: 24rpx;
    color: #8B86A8;
    margin-top: 2rpx;
}

/* 游戏化头部：等级 + 经验条 + 连胜 */
.gamify {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24rpx 28rpx;
}

.gamify-left {
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 0;
}

.level-badge {
    min-width: 76rpx;
    height: 76rpx;
    border-radius: 50%;
    background: linear-gradient(135deg, #9B7BFF 0%, #7C5CFC 100%);
    color: #ffffff;
    font-size: 26rpx;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 20rpx;
    box-shadow: 0 6rpx 16rpx rgba(124, 92, 252, 0.3);
    flex-shrink: 0;
}

.gamify-info {
    flex: 1;
    min-width: 0;
}

.gamify-name {
    font-size: 28rpx;
    font-weight: 600;
    color: #2B2350;
}

.xp-bar {
    height: 14rpx;
    background: #EEEAFF;
    border-radius: 999rpx;
    margin: 10rpx 0 6rpx;
    overflow: hidden;
}

.xp-bar-fill {
    height: 100%;
    border-radius: 999rpx;
    background: linear-gradient(90deg, #9B7BFF 0%, #7C5CFC 100%);
}

.gamify-xp {
    font-size: 20rpx;
    color: #8B86A8;
}

.gamify-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    margin-left: 20rpx;
    flex-shrink: 0;
}

.streak {
    font-size: 28rpx;
    font-weight: 700;
    color: #FF9F43;
}

.today-xp {
    font-size: 22rpx;
    color: #6E6A8F;
    margin-top: 4rpx;
}

.rank-link {
    font-size: 22rpx;
    color: #7C5CFC;
    margin-top: 4rpx;
}

/* 掌握度环 + 今日复习 */
.mastery-row {
    display: flex;
    margin: 0 -8rpx 16rpx;
}

.mastery {
    width: calc(58% - 16rpx);
    margin: 0 8rpx 16rpx;
    display: flex;
    align-items: center;
    box-sizing: border-box;
}

.ring-wrap {
    position: relative;
    width: 160rpx;
    height: 160rpx;
    flex-shrink: 0;
}

.ring-canvas {
    width: 160rpx;
    height: 160rpx;
}

.ring-hole {
    position: absolute;
    left: 0;
    top: 0;
    width: 160rpx;
    height: 160rpx;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    pointer-events: none;
}

.ring-num {
    font-size: 34rpx;
    font-weight: 700;
    color: #7C5CFC;
    line-height: 1.1;
}

.ring-label {
    font-size: 20rpx;
    color: #8B86A8;
}

.mastery-legend {
    margin-left: 20rpx;
    display: flex;
    flex-direction: column;
    gap: 8rpx;
    min-width: 0;
}

.legend-item {
    display: flex;
    align-items: center;
    font-size: 22rpx;
    color: #6E6A8F;
}

.dot {
    width: 14rpx;
    height: 14rpx;
    border-radius: 50%;
    margin-right: 10rpx;
    flex-shrink: 0;
}

.dot-done {
    background: #7C5CFC;
}

.dot-learning {
    background: #FF9F43;
}

.dot-fresh {
    background: #DED7FA;
}

.review {
    width: calc(42% - 16rpx);
    margin: 0 8rpx 16rpx;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.mascot {
    font-size: 48rpx;
    line-height: 1;
    margin-bottom: 8rpx;
}

.review-title {
    font-size: 24rpx;
    color: #6E6A8F;
}

.review-num {
    font-size: 44rpx;
    font-weight: 700;
    color: #2B2350;
    line-height: 1.2;
}

.review-desc {
    font-size: 20rpx;
    color: #8B86A8;
    margin-bottom: 12rpx;
}

.review-btn {
    font-size: 24rpx;
    padding: 10rpx 24rpx;
}
