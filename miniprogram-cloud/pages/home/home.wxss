.hero {
    background: linear-gradient(160deg, #F1ECFF 0%, #FBFAFF 55%, #ffffff 100%);
    border-radius: 24rpx;
    padding: 36rpx 32rpx;
    margin-bottom: 24rpx;
}

.hero-eyebrow {
    display: block;
    font-size: 20rpx;
    letter-spacing: 4rpx;
    color: #7C5CFC;
    font-weight: 700;
    margin-bottom: 16rpx;
}

.hero-title {
    display: block;
    font-size: 42rpx;
    font-weight: 700;
    color: #2B2350;
    line-height: 1.35;
    margin-bottom: 16rpx;
}

.hero-desc {
    display: block;
    font-size: 26rpx;
    color: #6E6A8F;
    margin-bottom: 28rpx;
}

.hero-btn {
    align-self: flex-start;
}

.stats {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -8rpx 16rpx;
}

.stat {
    width: calc(50% - 16rpx);
    box-sizing: border-box;
    background: #ffffff;
    border-radius: 20rpx;
    padding: 24rpx;
    margin: 0 8rpx 16rpx;
    box-shadow: 0 4rpx 16rpx rgba(76, 55, 168, 0.08);
    display: flex;
    flex-direction: column;
}

.stat-label {
    font-size: 22rpx;
    color: #8B86A8;
}

.stat-value {
    font-size: 48rpx;
    font-weight: 700;
    color: #2B2350;
    margin: 6rpx 0;
}

.stat-hint {
    font-size: 20rpx;
    color: #A9A4C4;
}

.section-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16rpx;
}

.section-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #2B2350;
    display: block;
    margin-bottom: 16rpx;
}

.section-head .section-title {
    margin-bottom: 0;
}

.entry {
    display: flex;
    align-items: center;
    padding: 24rpx 0;
    border-top: 1rpx solid #EFEAF8;
}

.entry:first-of-type {
    border-top: none;
}

.entry-body {
    flex: 1;
    min-width: 0;
}

.entry-title {
    display: block;
    font-size: 28rpx;
    font-weight: 600;
    color: #2B2350;
}

.entry-desc {
    display: block;
    font-size: 24rpx;
    color: #8B86A8;
    margin-top: 4rpx;
}

.entry-trailing {
    font-size: 26rpx;
    color: #7C5CFC;
    margin-left: 16rpx;
    flex-shrink: 0;
}

.step {
    display: flex;
    align-items: flex-start;
    margin-top: 20rpx;
}

.step-num {
    width: 44rpx;
    height: 44rpx;
    border-radius: 50%;
    background: #EEEAFF;
    color: #7C5CFC;
    font-size: 24rpx;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 20rpx;
    flex-shrink: 0;
}

.step-title {
    display: block;
    font-size: 28rpx;
    font-weight: 600;
    color: #2B2350;
}

.step-desc {
    display: block;
    font-size: 24rpx;
    color: #8B86A8;
    margin-top: 2rpx;
}
