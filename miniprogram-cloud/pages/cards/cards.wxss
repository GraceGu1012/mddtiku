.search-input {
    background: #EFEAF8;
    border-radius: 12rpx;
    padding: 16rpx 24rpx;
    font-size: 26rpx;
    margin-bottom: 16rpx;
}

.picker-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8rpx 0;
}

.picker-value {
    font-size: 26rpx;
    color: #7C5CFC;
}

.card-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    margin-left: 16rpx;
}

.card-action-btn {
    font-size: 24rpx;
    color: #7C5CFC;
    border: 1rpx solid #C9BCF7;
    border-radius: 999rpx;
    padding: 8rpx 20rpx;
}

.card-action-rating {
    font-size: 20rpx;
    color: #A9A4C4;
    margin-top: 8rpx;
}

.mascot-big {
    font-size: 88rpx;
    line-height: 1.2;
    margin-bottom: 16rpx;
}

.exit-review {
    display: inline-block;
    font-size: 24rpx;
    color: #7C5CFC;
    margin-bottom: 16rpx;
}
