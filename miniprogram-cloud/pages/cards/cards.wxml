<view class="page">
    <view wx:if="{{state === 'loading'}}" class="state-box">
        <view class="spinner"></view>
        <text class="state-text">正在读取知识卡…</text>
    </view>

    <view wx:elif="{{state === 'error'}}" class="state-box">
        <text class="state-title">暂时无法打开</text>
        <text class="state-text">{{errorMsg}}</text>
        <button class="btn btn-primary" bindtap="handleRetry">重试</button>
    </view>

    <block wx:else>
        <text class="heading-title">知识卡</text>
        <text class="heading-sub">先回忆，再翻面。自评帮助安排复习，不等于测验成绩。</text>

        <view class="panel">
            <input class="search-input" placeholder="输入问题或知识点" value="{{keyword}}" bindinput="onSearch" />
            <picker range="{{filters}}" value="{{filterIndex}}" bindchange="onFilterChange">
                <view class="picker-row">
                    <text class="muted">复习范围</text>
                    <text class="picker-value">{{filters[filterIndex]}} ›</text>
                </view>
            </picker>
            <text class="footer-note">已审核 {{total}} 张 · 已记住 {{rememberedCount}} 张（自评）</text>
        </view>

        <block wx:if="{{list.length > 0}}">
            <view class="item-row" wx:for="{{list}}" wx:key="id">
                <text class="item-number">{{item.number}}</text>
                <view class="item-body">
                    <view>
                        <text wx:for="{{item.pills}}" wx:for-item="pill" wx:key="index" class="pill {{pill.blue ? 'pill-blue' : ''}}">{{pill.text}}</text>
                    </view>
                    <text class="item-title">{{item.prompt}}</text>
                    <text class="item-foot">{{item.foot}}</text>
                </view>
                <view class="card-action" data-id="{{item.id}}" bindtap="goCard">
                    <text class="card-action-btn">翻卡学习</text>
                    <text class="card-action-rating">{{item.ratingText}}</text>
                </view>
            </view>
        </block>

        <view wx:else class="state-box">
            <text class="state-title">当前没有知识卡</text>
            <text class="state-text">调整筛选条件，或等待老师审核发布。</text>
        </view>
    </block>
</view>
